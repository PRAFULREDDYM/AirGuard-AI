# AirGuard AI Environment Variables

# Environment & Server
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# Database
# For SQLite (default zero-friction local mode):
DATABASE_URL=sqlite+aiosqlite:///./airguard.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://airguard:airguard_secure_password@localhost:5432/airguard

# Security Keys
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
AIRGUARD_ENCRYPTION_KEY=replace-with-a-32-byte-aes-gcm-key!!

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

